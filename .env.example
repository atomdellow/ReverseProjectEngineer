# Environment Variables
MONGO_URI=mongodb://localhost:27017/rpe
REDIS_URL=redis://localhost:6379

# Application Secret (Generate a 32+ character random string)
APP_SECRET=your-super-secret-32-char-plus-key-here

# Jira Configuration
ATLASSIAN_SITE=https://your-domain.atlassian.net

# Jira Authentication (Use either API Token or OAuth)
# API Token Method (recommended for development)
JIRA_EMAIL=your-email@example.com
JIRA_API_TOKEN=your-jira-api-token

# OAuth Method (for production)
# JIRA_OAUTH_CLIENT_ID=your-oauth-client-id
# JIRA_OAUTH_CLIENT_SECRET=your-oauth-client-secret

# Optional Confluence Integration
# CONFLUENCE_SPACE_KEY=YOUR_SPACE
# CONFLUENCE_ROOT_PAGE_ID=123456

# API Security
API_KEY=dev-api-key-change-in-production

# Logging
LOG_LEVEL=info

# Node Environment
NODE_ENV=development
PORT=3000