{
  "name": "rpe-backend",
  "version": "1.0.0",
  "description": "Backend API for Reverse Project Engineer",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "queue:worker": "tsx src/jobs/queue.ts",
    "seed": "tsx src/scripts/seed.ts",
    "demo": "tsx src/scripts/demo.ts",
    "sync:preview": "tsx -e \"import('./src/services/jira.service').then(s => s.previewSync())\"",
    "sync:apply": "tsx -e \"import('./src/services/jira.service').then(s => s.applySync())\""
  },
  "dependencies": {
    "@babel/parser": "^7.23.6",
    "axios": "^1.6.2",
    "bcryptjs": "^2.4.3",
    "bullmq": "^4.15.1",
    "crypto": "^1.0.1",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "ioredis": "^5.3.2",
    "mongoose": "^8.0.3",
    "winston": "^3.11.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.8",
    "@types/node": "^20.10.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "tsx": "^4.6.0",
    "typescript": "^5.3.2"
  }
}